        <PackageReference Include="MongoDB.Driver" Version="3.12.0"/>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7"/>
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyAIAgent.Common.Infrastructure\MyAIAgent.Common.Infrastructure.csproj"/>
        <ProjectReference Include="..\MyAIAgent.KernelMemory.Application\MyAIAgent.KernelMemory.Application.csproj"/>
    </ItemGroup>

</Project>
