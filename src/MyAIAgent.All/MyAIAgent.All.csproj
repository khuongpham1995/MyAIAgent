    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MyAIAgent.McpServer.Presentation\MyAIAgent.McpServer.Presentation.csproj" />
      <ProjectReference Include="..\MyAIAgent.Orchestrator.Presentation\MyAIAgent.Orchestrator.Presentation.csproj" />
      <ProjectReference Include="..\MyAIAgent.KernelMemory.Presentation\MyAIAgent.KernelMemory.Presentation.csproj" />
      <ProjectReference Include="..\MyAIAgent.Gateway.Presentation\MyAIAgent.Gateway.Presentation.csproj" />
    </ItemGroup>

</Project>
