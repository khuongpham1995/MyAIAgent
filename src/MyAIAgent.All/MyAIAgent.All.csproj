<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>ffdafd93-48eb-4993-8fb5-b47a62b7656d</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <!-- Aspire 13.6.1 still resolves a vulnerable MessagePack patch through StreamJsonRpc. -->
