{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppConfig": "",
    "CosmosDb": ""
  },
  "CosmosDb": {
    "DatabaseName": "myaiagent-test"
  },
  "KernelMemory": {
    "Service": {
      "RunWebService": true,
      "RunHandlers": true,
      "OpenApiEnabled": false,
      "MaxUploadSizeMb": null
    },
    "DefaultIndexName": "myaiagent-test",
    "TextGeneratorType": "AzureOpenAI",
    "ContentModerationType": "",
    "ServiceAuthorization": {
      "Enabled": true,
      "AuthenticationType": "APIKey",
      "HttpHeaderName": "Authorization",
      "AccessKey1": "",
      "AccessKey2": ""
    },
    "DataIngestion": {
      "OrchestrationType": "InProcess",
      "EmbeddingGenerationEnabled": true,
      "EmbeddingGeneratorTypes": [ "AzureOpenAIEmbedding" ],
      "MemoryDbTypes": [ "AzureAISearch" ],
      "ImageOcrType": "None",
      "TextPartitioning": {
        "MaxTokensPerParagraph": 1000,
        "OverlappingTokens": 100
      }
    },
    "Retrieval": {
      "MemoryDbType": "AzureAISearch",
      "EmbeddingGeneratorType": "AzureOpenAIEmbedding",
      "SearchClient": {
        "MaxMatchesCount": 100,
        "AnswerTokens": 300,
        "EmptyAnswer": "INFO NOT FOUND",
        "Temperature": 0.0,
        "UseContentModeration": false
      }
    },
    "Services": {
      "AzureOpenAIEmbedding": {
        "APIType": "EmbeddingGeneration",
        "Auth": "ApiKey",
        "Endpoint": "",
        "Deployment": "text-embedding-ada-002",
        "APIKey": ""
      },
      "AzureOpenAIText": {
        "Auth": "ApiKey",
        "Endpoint": "",
        "Deployment": "gpt-4o-mini",
        "APIKey": ""
      },
      "AzureAISearch": {
        "Auth": "ApiKey",
        "Endpoint": "",
        "APIKey": ""
      },
      "SimpleFileStorage": {
        "StorageType": "Volatile"
      }
    }
  }
}
